load @term/base/maybe
  find maybe
  find is-none
  find unwrap


# `zone show` — what this machine is bound to.
#
# It prints configuration and never a value, not even a masked fragment. A
# prefix like `sk-proj-...` still says which service the key belongs to and
# which account minted it, so masking is not as safe as it looks.

load ../base
  find bond

load ../config/machine
  find read-bond
  find berth
  find bind-sort
  find pick-sort


load ../save/base
  find pick
  find keep

load ../hold/base
  find good

load @term/base/text
  find text
  find to-upper-case
  find replace-all
load @term/base/boolean
  find boolean

load ../tool/base
  find join-text
  find yes-no

load ../tool/say
  find name-run
  find say-next
  find say-facts
  find finish

task show
  mark async
  take sort, like text
  like number

  call name-run
    text <show>
  save bond
    call read-bond
      bind hold, text <>
  fork test
    hook test
      call is-none
        read bond
    hook hold
      call say-next
        text <info>
        text <This machine is not bound>
        text <zone bind --team \<team\>>
      send back
        call finish
          text <Not bound>
  save bond-in
    call unwrap
      read bond

  save sort-in
    call pick-sort
      bind bond, read bond-in
      bind sort, read sort

  save kind
    call pick
  save spot
    call berth
      bind bond, read bond-in
      bind sort, read sort-in

  # one item, the binding's facts as its fields (output standard section 14)
  save facts
    make list
      call join-text
        make list
          text <mind >
          read bond-in/mind
      call join-text
        make list
          text <host >
          read bond-in/host
      call join-text
        make list
          text <sort >
          read sort-in
      call join-text
        make list
          text <hold >
          read bond-in/hold
      call join-text
        make list
          text <save >
          read kind
      call join-text
        make list
          text <code >
          call yes-no
            call keep
              bind kind, read kind
              bind spot, read spot
  call say-facts
    text <info>
    call join-text
      make list
        text <bound as >
        read bond-in/mind
        text < on >
        read bond-in/host
    read facts
  send back
    call finish
      text <Bound>
