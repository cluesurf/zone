# `zone files` — which declarations are in force here, in order.
#
# Answers "which zone.tree am I actually running" in one command, which is
# otherwise a guess. The search walks up from the working directory and stops
# at the first declaration saying `root true`, so what is in force is not
# always what is nearest and is never obvious from a listing.
#
# Names the cache beside each one too, and whether it exists, because the
# other half of that question is "and is anything cached for it".

load @term/base/text
  find text

load @term/base/list
  find list
  find length

load @term/base/boolean
  find boolean

load ../config/find
  find read-decks
  find halt-no-deck

load ../work/load
  find spot-cache

load ../tool/base
  find join-text
  find join-line
  find halt
  find here
  find have-file

load ../tool/say
  find name-run
  find say-info
  find say-facts
  find finish

task files
  mark async
  like number

  call name-run
    text <deck>
  save all
    call read-decks

  fork test
    hook test
      call is-equal
        call length
          read all
        code 0
    hook hold
      send back
        call halt-no-deck

  call say-info
    call join-line
      make list
        text <Read from, nearest first, starting at:>
        call here

  # one item per declaration, its cache as a field
  walk list, read all
    hook next
      take site, name one
      save at-cache
        call spot-cache
          read one
      save cache-line
        call join-text
          make list
            text <cache none yet. `zone read` makes one.>
      fork test
        hook test
          call have-file
            read at-cache
        hook hold
          save cache-line
            call join-text
              make list
                text <cache >
                read at-cache
      save facts
        make list
          read cache-line
      call say-facts
        text <info>
        read one
        read facts

  send back
    call finish
      text <Listed>
