# One secret at a time.
#
#   zone save --name some-key   write it, read from a hidden prompt
#   zone read --name some-key   ask about that one, when it drifted
#   zone toss --name some-key   remove it at the provider
#
# `--name` IS NOT OPTIONAL, and the bare positional is not a shorthand for
# it. The first positional binds to `--spot`, a zone PATH, so
# `zone save some-key` walks the whole declaration and reports on
# projects instead of prompting for a value. It exits 0, which is why the
# form was documented that way here and in Term's command reference for as long
# as it was: it does not look like it failed.
#
# THE VALUE IS NEVER SEEN. It is typed with echo off, handed to the provider
# SDK as a function argument, and never reaches a file, an argument, a log or
# the terminal. `bws` cannot do this: it takes the value on its command line,
# where anything that can list processes reads it.
#
# WHICH ZONE A NAME BELONGS TO IS ASKED ONLY WHEN THE DECLARATION CANNOT SAY.
# A name declared in one zone belongs to that zone. A name declared in two
# (`database-url` at mesh, and again under `zone moon` as the development
# override) is two values, and every command here refuses it until
# `--spot` names the zone. Each zone's value is its own secret at the
# provider, its note naming that zone, and a command reaches only the
# copies whose note names the zone it was given (`pick-home`, `own-copies`).

load @term/base/text
  find text

load @term/base/list
  find list
  find length
  find push

load @term/base/boolean
  find boolean

load @term/base/maybe
  find maybe
  find is-none
  find unwrap

load ../base
  find spot
  find bond
  find hold-copy

load ../config/find
  find read-decks
  find halt-no-deck

load ../config/zone
  find mine-zone
  find find-spot
  find pull-need
  find all-paths
  find find-lock
  find mine-file
  find is-note

load ../config/machine
  find read-bond
  find berth

load ../save/base
  find pick
  find read-code

load ./load
  find spot-cache

load ../hold/bitwarden
  find bitwarden-put
  find bitwarden-copies
  find bitwarden-drop
  find bitwarden-one

load ../tool/note
  find note-make
  find note-has
  find note-zones

load ../tool/base
  find join-text
  find join-line
  find show-line
  find warn-line
  find ask-secret
  find hook-text
  find halt
  find equal
  find not-equal
  find read-file
  find have-file
  find here
  find show-size
  find show-count
  find more

load ../tool/say
  find name-run
  find say-done
  find say-fail
  find say-next
  find finish
  find finish-next

# The declaration alone: what a command needs when it never opens the
# provider. `scan` is the whole reason this is separate from `gear`.
form home
  link root, like spot
  # the declaration file itself, because the cache sits beside it
  link deck, like text

# Everything the three commands need before they can do anything: the
# declaration, the machine binding and the provider credential.
form gear
  link root, like spot
  link token, like text
  # the declaration file itself, because the cache sits beside it
  link deck, like text

task home-up
  mark async
  like home

  save decks
    call read-decks
  fork test
    hook test
      call is-equal
        call length
          read decks
        code 0
    hook hold
      call halt-no-deck

  save deck, text <>
  walk list, read decks
    hook next
      take site, name one
      fork test
        hook test
          call equal
            read deck
            text <>
        hook hold
          save deck, read one

  send back
    make home
      bind deck, read deck
      bind root
        call mine-zone
          call read-file
            read deck

# Everything the provider commands need: the declaration, the machine
# binding and the bootstrap credential.
#
# `scan` does NOT come through here. It reads the declaration and the cache,
# both already on disk, so demanding a credential it never uses would refuse
# a command that can answer perfectly well without one.
task gear-up
  mark async
  like gear

  save it
    call home-up
  save root, read it/root
  save deck, read it/deck

  fork test
    hook test
      call equal
        read root/team
        text <>
    hook hold
      call halt
        call join-line
          make list
            text <The declaration does not say which organization it belongs to.>
            text <>
            text <Add a `team` line to zone.tree with the organization id:>
            text <>
            text <  team 00000000-0000-0000-0000-000000000000>
            text <>
            text <The provider's own command derives it from the credential. The>
            text <library this uses does not: every call takes it. It is a uuid,>
            text <not a secret.>

  save bond-got
    call read-bond
      bind hold, text <>
  fork test
    hook test
      call is-none
        read bond-got
    hook hold
      call halt
        text <This machine is not bound. Run `zone bind` first.>
  save bond
    call unwrap
      read bond-got

  save code-got
    call read-code
      bind kind
        call pick
      bind spot
        call berth
          bind bond, read bond
          bind sort, read bond/base
  fork test
    hook test
      call is-none
        read code-got
    hook hold
      call halt
        text <No bootstrap credential for this machine, so the provider cannot be opened. Run `zone code save`.>

  send back
    make gear
      bind root, read root
      bind deck, read deck
      bind token
        call unwrap
          read code-got

# WHICH ZONE A NAME IS WRITTEN UNDER, and why it is never guessed.
#
# A name can be declared in more than one zone ON PURPOSE. `database-url`
# at the root of a `zone.tree` is production, and under `zone dev` it is
# the development pool. Those are TWO values: two secrets at the provider
# under one key, each with a note naming its own zone, and the read path
# seals each zone from the copy whose note names it (`holds-for` in
# `work/read.tree`).
#
# This used to pick the INNERMOST declaring zone in silence. On
# 2026-10-14 `zone save --name database-url --zone moon` was run to store
# the development pool: `--zone` is not a flag here and was ignored, the
# innermost rule chose a zone, and the writer then overwrote EVERY copy
# under the key, production's included. So a name declared in more than
# one zone is now refused until `--spot` says which, and the writer
# touches only that zone's copies.

# Every zone that declares a name itself, root first.
task homes-of
  take at, like spot
  take name, like text
  like list, like spot
  save out, like list, like spot
    make list
  fork test
    hook test
      call declares
        bind at, read at
        bind name, read name
    hook hold
      call push
        bind list, read out
        bind item, read at
  walk list, read at/zone
    hook next
      take site, name kid
      walk list
        call homes-of
          bind at, read kid
          bind name, read name
        hook next
          take site, name one
          call push
            bind list, read out
            bind item, read one
  send back
    read out

# Whether a zone declares a name itself, as a `need` or a `want`.
task declares
  take at, like spot
  take name, like text
  like boolean
  walk list, read at/need
    hook next
      take site, name one
      fork test
        hook test
          call equal
            read one/name
            read name
        hook hold
          send back, true
  send back, false

# Whether a zone supplies a name of its own: declared, or published as
# another declaration's spelling (`name database-url` under a `need`). A
# zone that does either never reads the value inherited from above.
task covers
  take at, like spot
  take name, like text
  like boolean
  walk list, read at/need
    hook next
      take site, name one
      fork test
        hook test
          call equal
            read one/name
            read name
        hook hold
          send back, true
      walk list, read one/alias
        hook next
          take site, name two
          fork test
            hook test
              call equal
                read two
                read name
            hook hold
              send back, true
  send back, false

# Every zone that reads the value filed under one zone: that zone, and
# each zone below it that does not supply the name itself. This is what a
# save changes, so it is what the report names.
task reach-of
  take at, like spot
  take name, like text
  like list, like text
  save out, like list, like text
    make list
  call push
    bind list, read out
    bind item, read at/path
  walk list, read at/zone
    hook next
      take site, name kid
      fork test
        hook test
          call covers
            bind at, read kid
            bind name, read name
        hook hold
          turn next
      walk list
        call reach-of
          bind at, read kid
          bind name, read name
        hook next
          take site, name one
          call push
            bind list, read out
            bind item, read one
  send back
    read out

# The key a value is STORED under at the provider: the `from` on THIS
# zone's own declaration when it gives one, the declared name otherwise.
#
#   need work-volume-size, from tf-var-work-volume-size
#
# says the provider's key is `tf-var-work-volume-size`, and that is the
# key `zone read` fetches by (`seal-spot` in `work/read.tree`). A save
# that wrote under the DECLARED name put a second secret beside the real
# one and the value tofu read stayed 400 (2026-09-21). Read off the zone
# being written, never the innermost declaration, so a `from` on an
# override cannot redirect the root's key or the reverse.
task key-at
  take at, like spot
  take name, like text
  like text
  save out, read name
  walk list, read at/need
    hook next
      take site, name one
      fork test
        hook test
          call equal
            read one/name
            read name
        hook hold
          fork test
            hook test
              call not-equal
                read one/from
                text <>
            hook hold
              save out, read one/from
  send back
    read out

# `a`, `a and b`, `a, b and c`.
bind and-list
  take list, like list, like text
  like text
  case node
    text <(function (a) \{ return a.length \< 2 ? a.join("") : a.slice(0, -1).join(", ") + " and " + a[a.length - 1] \})($list)>

# The paths of a list of zones.
task paths-of
  take all, like list, like spot
  like list, like text
  save out, like list, like text
    make list
  walk list, read all
    hook next
      take site, name one
      call push
        bind list, read out
        bind item, read one/path
  send back
    read out

# The lines that say which zones declare a name and the command for each.
task spot-lines
  take name, like text
  take homes, like list, like spot
  take verb, like text
  take lead, like text
  like list, like text
  save out, like list, like text
    make list
  call push
    bind list, read out
    bind item, read lead
  call push
    bind list, read out
    bind item, text <>
  call push
    bind list, read out
    bind item, text <Pass --spot to choose:>
  call push
    bind list, read out
    bind item, text <>
  walk list, read homes
    hook next
      take site, name one
      call push
        bind list, read out
        bind item
          call join-text
            make list
              text <  zone >
              read verb
              text < --name >
              read name
              text < --spot >
              read one/path
  call push
    bind list, read out
    bind item, text <>
  call push
    bind list, read out
    bind item, text <Each zone keeps its own value at the provider. A command reaches ONE>
  call push
    bind list, read out
    bind item, text <zone's copy and never another's.>
  send back
    read out

# The zone a one-name command acts on, or a refusal that says how to name it.
#
#   no `--spot`, one declaring zone     that zone
#   no `--spot`, several                refused, listing each with its command
#   `--spot` naming a declaring zone    that zone
#   `--spot` naming anything else       refused: a value filed there would
#                                       never be read, because a zone is
#                                       sealed only from its own declarations
task pick-home
  take root, like spot
  take name, like text
  take spot, like text
  # the command, for the lines it prints: save, toss, read, hook
  take verb, like text
  like spot

  save homes
    call homes-of
      bind at, read root
      bind name, read name

  fork test
    hook test
      call is-equal
        call length
          read homes
        code 0
    hook hold
      call halt
        call join-line
          make list
            call join-text
              make list
                text <Nothing declares >
                read name
                text <.>
            text <>
            text <Add it to zone.tree first, so the tree says it exists:>
            text <>
            call join-text
              make list
                text <  need >
                read name

  save paths
    call paths-of
      read homes

  fork test
    hook test
      call equal
        read spot
        text <>
    hook hold
      fork test
        hook test
          call is-equal
            call length
              read homes
            code 1
        hook hold
          send back, read homes/0
      call halt
        call join-line
          call spot-lines
            bind name, read name
            bind homes, read homes
            bind verb, read verb
            bind lead
              call join-text
                make list
                  read name
                  text < is declared at >
                  call and-list
                    read paths
                  text <, and each holds a different value.>

  save got
    call find-spot
      bind root, read root
      bind path, read spot
  fork test
    hook test
      call is-none
        read got
    hook hold
      call halt
        call join-line
          call spot-lines
            bind name, read name
            bind homes, read homes
            bind verb, read verb
            bind lead
              call join-text
                make list
                  text <No zone at >
                  read spot
                  text <. >
                  read name
                  text < is declared at >
                  call and-list
                    read paths
                  text <.>
  save at
    call unwrap
      read got

  fork test
    hook test
      call declares
        bind at, read at
        bind name, read name
    hook hold
      send back, read at

  call halt
    call join-line
      call spot-lines
        bind name, read name
        bind homes, read homes
        bind verb, read verb
        bind lead
          call join-text
            make list
              read name
              text < is not declared at >
              read at/path
              text <, so a value filed there would never be read. It is declared at >
              call and-list
                read paths
              text <.>
  send back, read at

# The copies of a name that belong to one zone.
#
# In `note` mode, every copy whose note names the zone, which is how an
# override and the value it overrides stay apart under one key. In
# `project` mode, every copy filed in the zone's own project. Several
# copies of ONE zone (`wikimedia-pwd` beside `WIKIMEDIA_PWD`) are all
# written, so that zone's readers agree whichever one they keep.
task own-copies
  take all, like list, like hold-copy
  take path, like text
  take note, like boolean
  like list, like hold-copy
  save out, like list, like hold-copy
    make list
  walk list, read all
    hook next
      take site, name one
      save mine, false
      fork test
        hook test
          read note
        hook hold
          save mine
            call note-has
              bind note, read one/note
              bind want, read path
        hook miss
          save mine
            call equal
              read one/bank
              read path
      fork test
        hook test
          read mine
        hook hold
          call push
            bind list, read out
            bind item, read one
  send back
    read out

# The ids of some copies.
task ids-of
  take all, like list, like hold-copy
  like list, like text
  save out, like list, like text
    make list
  walk list, read all
    hook next
      take site, name one
      call push
        bind list, read out
        bind item, read one/body
  send back
    read out

# One zone's copies of a name, fetched: what `put-one`, `drop-one`,
# `see-one` and `hook-one` each start from.
form aim
  link at, like spot
  link key, like text
  link all, like list, like hold-copy
  link mine, like list, like hold-copy

task aim-at
  mark async
  take gear, like gear
  take at, like spot
  take name, like text
  like aim
  save key
    call key-at
      bind at, read at
      bind name, read name
  save all
    call bitwarden-copies
      bind body, read gear/token
      bind team, read gear/root/team
      bind name, read key
  save mine
    call own-copies
      bind all, read all
      bind path, read at/path
      bind note
        call is-note
          read gear/root
  send back
    make aim
      bind at, read at
      bind key, read key
      bind all, read all
      bind mine, read mine

# `zone save --name <name> [--spot <zone>]`: write one value, read from a
# hidden prompt.
#
# REPORTS BY DEFAULT AND WRITES ONLY ON `--commit`, like everything else
# that writes here. Without the flag it says which zone the value would
# be filed under, every zone that reads that value, and the zones whose
# own values under the same name it leaves alone, then stops before asking
# for one.
#
# THE VALUE IS THE BYTES TYPED, trimmed of surrounding whitespace and
# nothing else. `1000`, `3.5`, `true`, a url, a line with spaces and
# quotes: each is stored as the text it was typed as and comes back out
# of `zone load` as the same text. A multi-line value, such as a PEM key,
# is piped in: when stdin is not a terminal the whole of it is taken.
# `zone/test/save.sh` holds every one of those shapes through the
# provider, the cache and a child process, and `zone/test/spot.sh` holds
# a name two zones keep apart.
task put-one
  mark async
  take name, like text
  take spot, like text
  take commit, like boolean
  like number

  save it
    call gear-up
  save at
    call pick-home
      bind root, read it/root
      bind name, read name
      bind spot, read spot
      bind verb, text <save>
  save home, read at/path
  save key
    call key-at
      bind at, read at
      bind name, read name
  save reach
    call reach-of
      bind at, read at
      bind name, read name
  save homes
    call paths-of
      call homes-of
        bind at, read it/root
        bind name, read name
  save others, like list, like text
    make list
  walk list, read homes
    hook next
      take site, name one
      fork test
        hook test
          call not-equal
            read one
            read home
        hook hold
          call push
            bind list, read others
            bind item, read one

  fork test
    hook test
      read commit
    hook miss
      call show-line
        call join-text
          make list
            text <would write >
            read name
            text < at >
            read home
            call stored-as
              bind name, read name
              bind key, read key
      call show-reach
        bind reach, read reach
        bind others, read others
      # `zone save` (keep-zone) closes the run
      call say-next
        text <info>
        text <Report only. Add --commit to write, and the value is asked for then.>
        call join-text
          make list
            text <zone save --name >
            read name
            call spot-flag
              read spot
            text < --commit>
      send back
        code 0

  call show-line
    call join-text
      make list
        text <writing >
        read name
        text < at >
        read home
        call stored-as
          bind name, read name
          bind key, read key
  call show-reach
    bind reach, read reach
    bind others, read others

  save body
    call ask-secret
      call join-text
        make list
          read name
          text < for >
          read home
          text <: >

  fork test
    hook test
      call equal
        read body
        text <>
    hook hold
      send back
        call halt
          text <Nothing was typed, so nothing was written.>

  # WHICH PROJECT THE VALUE IS FILED IN, by mode, the same rule the
  # read path follows. In `note` mode there is ONE project, named on the
  # declaration's `base` block, and the zone is recorded in the secret's
  # note. In `project` mode there is one project per zone and its name
  # IS the zone path.
  save bank
    read home
  fork test
    hook test
      call is-note
        read it/root
    hook hold
      save bank
        read it/root/bank

  save aim
    call aim-at
      bind gear, read it
      bind at, read at
      bind name, read name

  # THE NOTE OF A NEW COPY NAMES THIS ZONE ALONE. An existing copy keeps
  # its own note (`vault.put`), so a value shared with a second
  # declaration by `zone share` stays shared. A copy that belongs to
  # another zone is never in `ids`, so its value and its note are never
  # touched: that is the whole of the 2026-10-14 fix.
  save zones, like list, like text
    make list
  call push
    bind list, read zones
    bind item, read home
  save mind
    call note-make
      read zones

  save what
    call bitwarden-put
      bind body, read it/token
      bind team, read it/root/team
      bind bank, read bank
      bind mind, read mind
      bind name, read key
      bind code, read body
      bind ids
        call ids-of
          read aim/mine

  call say-done
    call join-text
      make list
        read name
        text < >
        read what
        text < at >
        read home
        call stored-as
          bind name, read name
          bind key, read key

  save left
    call subtract
      call length
        read aim/all
      call length
        read aim/mine
  fork test
    hook test
      call more
        read left
        code 0
    hook hold
      call show-line
        call join-text
          make list
            text <left alone: >
            call show-count
              read left
            text < other copy or copies under this key, which belong to other zones>
  send back
    code 0

# The zones a write reaches, and the ones whose own values it leaves.
task show-reach
  take reach, like list, like text
  take others, like list, like text
  call show-line
    call join-text
      make list
        text <read by >
        call and-list
          read reach
  fork test
    hook test
      call more
        call length
          read others
        code 0
    hook hold
      call show-line
        call join-text
          make list
            text <not touched: >
            call and-list
              read others
            text <, which keep their own values>

# `, stored as <key>` when the provider's key differs from the declared
# name, so a person reading the line can find the secret in the vault.
task stored-as
  take name, like text
  take key, like text
  like text
  fork test
    hook test
      call equal
        read name
        read key
    hook hold
      send back
        text <>
  send back
    call join-text
      make list
        text <, stored as >
        read key

# ` --spot <zone>` when a zone was named, for a `next` line to repeat it.
task spot-flag
  take spot, like text
  like text
  fork test
    hook test
      call equal
        read spot
        text <>
    hook hold
      send back
        text <>
  send back
    call join-text
      make list
        text < --spot >
        read spot

# `zone toss --name <name> [--spot <zone>]`: remove one zone's value at
# the provider.
#
# ONLY THAT ZONE'S COPIES, by id. This used to remove the first secret
# under the key, which for a name two zones keep apart could be either.
# A copy whose note also names another declaration is refused, because
# removing it removes that reader's value too.
task drop-one
  mark async
  take name, like text
  take spot, like text
  like number

  save it
    call gear-up
  save at
    call pick-home
      bind root, read it/root
      bind name, read name
      bind spot, read spot
      bind verb, text <toss>
  save home, read at/path
  save aim
    call aim-at
      bind gear, read it
      bind at, read at
      bind name, read name

  fork test
    hook test
      call is-equal
        call length
          read aim/mine
        code 0
    hook hold
      call warn-line
        call join-text
          make list
            text <No copy of >
            read name
            text < belongs to >
            read home
            text < at the provider. Nothing was removed.>
      send back
        call finish
          text <Nothing to remove>

  walk list, read aim/mine
    hook next
      take site, name one
      fork test
        hook test
          call more
            call length
              call note-zones
                read one/note
            code 1
        hook hold
          send back
            call halt
              call join-line
                make list
                  call join-text
                    make list
                      read name
                      text < at >
                      read home
                      text < is shared with another declaration by its note, so removing it>
                  text <would remove that reader's value too. Nothing was removed.>

  save gone
    call bitwarden-drop
      bind body, read it/token
      bind team, read it/root/team
      bind ids
        call ids-of
          read aim/mine

  call say-done
    call join-line
      make list
        call join-text
          make list
            text <Removed >
            read name
            text < from >
            read home
            text < (>
            call show-count
              read gone
            text < copy or copies)>
        text <It is still declared in zone.tree. Remove its line under that zone too, or>
        text <the next command that wants it will refuse to start.>
  send back
    call finish
      text <Removed>

# `zone read --name <name> [--spot <zone>]`: is one zone's value there.
#
# Reports whether it is there, and never prints it. The cache is filled
# by `zone read`, which is one round trip per project; this is the
# narrower question of whether one zone's copy exists.
task see-one
  mark async
  take name, like text
  take spot, like text
  like number

  save it
    call gear-up
  save at
    call pick-home
      bind root, read it/root
      bind name, read name
      bind spot, read spot
      bind verb, text <read>
  save home, read at/path
  save aim
    call aim-at
      bind gear, read it
      bind at, read at
      bind name, read name

  fork test
    hook test
      call is-equal
        call length
          read aim/mine
        code 0
    hook hold
      call say-next
        text <warning>
        call join-text
          make list
            read name
            text <  declared at >
            read home
            text <, and NOT at the provider>
        call join-text
          make list
            text <zone save --name >
            read name
            text < --spot >
            read home
            text < --commit>
      send back
        call finish
          text <Not at the provider>
  call say-next
    text <done>
    call join-text
      make list
        read name
        text <  declared at >
        read home
        text <, and present at the provider>
    text <zone read --fresh>
  send back
    call finish
      text <Present>

# `zone hook --name <name> [--spot <zone>]`: put one zone's value on the
# clipboard, never on screen.
#
# The safer half of showing a value: it goes where a paste can reach it and
# nowhere a scrollback, a screen recording or a shoulder can.
task hook-one
  mark async
  take name, like text
  take spot, like text
  like number

  call name-run
    text <hook>
  save it
    call gear-up
  save at
    call pick-home
      bind root, read it/root
      bind name, read name
      bind spot, read spot
      bind verb, text <hook>
  save home, read at/path
  save aim
    call aim-at
      bind gear, read it
      bind at, read at
      bind name, read name

  save body, text <>
  walk list, read aim/mine
    hook next
      take site, name one
      fork test
        hook test
          call equal
            read body
            text <>
        hook hold
          save body
            call bitwarden-one
              bind body, read it/token
              bind team, read it/root/team
              bind id, read one/body

  fork test
    hook test
      call equal
        read body
        text <>
    hook hold
      send back
        call halt
          call join-text
            make list
              text <No value for >
              read name
              text < at >
              read home
              text < at the provider.>

  save bad
    call hook-text
      read body

  fork test
    hook test
      call not-equal
        read bad
        text <>
    hook hold
      send back
        call halt
          read bad

  call say-done
    call join-text
      make list
        read name
        text < at >
        read home
        text < is on the clipboard. It was not printed.>
  send back
    call finish
      text <On the clipboard>

# `zone scan` — what is wrong across the whole tree.
#
# `zone test` asks whether THIS machine works. This asks whether the
# declaration and the cache agree, for every zone rather than one, and it
# needs no provider and no network: everything it reads is already on disk.
#
# What it reports, per zone:
#
#   a required name with nothing sealed for it     the command will refuse
#   a sealed value nothing declares any more       dead weight, and a hint
#                                                  that a name was renamed
task scan-all
  mark async
  like number

  call name-run
    text <scan>
  # `home-up`, not `gear-up`: everything below is read from disk, so a
  # missing bootstrap credential must not refuse the command.
  save it
    call home-up
  save root, read it/root

  save at-cache
    call spot-cache
      read it/deck
  save cache
    call mine-file
      text <>
  fork test
    hook test
      call have-file
        read at-cache
    hook hold
      save cache
        call mine-file
          call read-file
            read at-cache

  save bad, code 0
  save seen, code 0

  walk list
    call all-paths
      read root
    hook next
      take site, name path
      save gone
        make list
      walk list
        call pull-need
          bind root, read root
          bind path, read path
        hook next
          take site, name one
          save got
            call find-lock
              bind root, read cache/root
              bind path, read path
              bind name, read one/name
          fork test
            hook test
              call is-none
                read got
            hook hold
              fork test
                hook test
                  read one/must
                hook hold
                  call push
                    bind list, read gone
                    bind item, read one/name
            hook miss
              save seen
                call add
                  read seen
                  code 1

      fork test
        hook test
          call more
            call length
              read gone
            code 0
        hook hold
          save bad
            call add
              read bad
              code 1
          save lines
            make list
          call push
            bind list, read lines
            bind item
              call join-text
                make list
                  read path
                  text <  >
                  call show-size
                    read gone
                  text < required and not sealed>
          walk list, read gone
            hook next
              take site, name one
              call push
                bind list, read lines
                bind item, read one
          call say-fail
            call join-line
              read lines

  fork test
    hook test
      call is-equal
        read bad
        code 0
    hook hold
      call say-done
        call join-text
          make list
            text <every zone is whole. >
            call show-count
              read seen
            text < values sealed.>
      send back
        call finish
          text <Whole>
  send back
    call finish-next
      text <Values are missing>
      text <zone read>
