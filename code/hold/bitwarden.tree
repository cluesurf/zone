
# Bitwarden Secrets Manager, reached through ONE pinned `bws` (decision 004).
#
# Every bind below calls the runtime shim `hold/runtime/vault.ts`, which
# fetches the pinned release once, checks it against the sha256 it carries,
# and runs only that binary. Never a `bws` from the PATH.
#
# The bootstrap credential goes to `bws` in its environment, not on its
# command line, because `--access-token` on a command line is readable by any
# process that can list the process table. It lives in that child's
# environment for the length of one call and is not inherited by anything
# else. The one argument that carries a secret is a written value, in
# `zone save` alone: the exception to decision 001 that decision 004 records.
#
# `secret list` is asked for one project and returns every secret in it.
# Filtering to the declared names happens on this side, so a manifest that
# asks for three names never carries the rest of the project into a command.

# WITHOUT THIS DOCK THE SHIM IS NEVER PREPENDED. The `case node` templates
# below call `vault.put` and friends, the bundle builds clean, and the first
# command to reach one dies with `ReferenceError: vault is not defined`. The
# dock is what tells the build a global is needed and where its source is.
dock load
  load <global:vault>, name vault

load ../base
  find pass
  find hold
  find bank
  find haul
  find hold-note
  find hold-copy

load @term/base/text
  find text
  find to-upper-case
  find replace-all

load @term/base/list
  find list

load @term/base/boolean
  find boolean

# Whether this machine can reach the provider: whether a `bws` is pinned
# for its platform. Nothing is fetched or run.
bind do-bitwarden-open
  like boolean
  case node
    text <vault.now.open()>

# Confirm the credential opens the project, without reading any values.
# This is what `zone code show` and `zone test` use, so a check never pulls
# secrets it does not need.
bind do-bitwarden-good
  take body, like text
  take bind, like text
  like boolean
  case node
    text <vault.now.good($body, $bind)>

# THE PROVIDER'S SPELLING DOES NOT MATTER.
#
# A secret loaded by hand may be `ARCJET_KEY` while the declaration calls it
# `arcjet-key`. Both name the same thing, and which one a person typed into a
# web form is not something zone should have an opinion about, so the key is
# folded to the declaration's form on the way in.
#
# Getting this wrong is not a failed lookup, it is a DUPLICATE: a migration
# that compares `arcjet-key` against `ARCJET_KEY` finds no match and writes a
# second copy of every secret beside the first.

# Every secret in one project, as name and value pairs. The caller narrows
# to what the manifest declared.
bind do-bitwarden-read
  take body, like text
  take bind, like text
  like list
  case node
    text <vault.now.read($body, $bind)>

# Create a project. Named after the zone path, so what a person sees in the
# provider is the address the declaration uses.
bind do-bitwarden-make
  take body, like text
  take name, like text
  like text
  case node
    text <vault.now.make($body, $name)>

# Several projects at once.
#
# ONE ROUND TRIP PER PROJECT, and the projects go together. A tree with eight
# zones is one wall clock round trip rather than eight, because the requests
# overlap instead of queueing. `zone read` on a whole tree is the only place
# this matters, and it is the place a person waits.
#
# A project that fails is reported as empty rather than taking the run down:
# the caller already refuses on a missing required name, and that message
# names the value, which is more use than a provider error naming a project.
bind do-bitwarden-read-many
  take body, like text
  take team, like text
  take list, like list, like text
  like list, like haul
  case node
    text <(async function () \{ var all = await vault.all($body, $team, $list); var want = $list; var by = \{\}; want.forEach(function (bind) \{ by[bind] = [] \}); var loose = []; all.forEach(function (one) \{ var row = \{ name: one.name, body: one.body, note: one.note \}; if (one.bind && by[one.bind]) \{ by[one.bind].push(row) \} else \{ loose.push(row) \} \}); return want.map(function (bind) \{ return \{ bind: bind, hold: by[bind].length ? by[bind] : loose \} \}) \})()>

# Exportable wrapper: a native `bind` is file-local.
task bitwarden-read-many
  mark async
  take body, like text
  take team, like text
  take list, like list, like text
  like list, like haul
  send back
    call do-bitwarden-read-many
      bind body, read body
      bind team, read team
      bind list, read list

# Every project the credential can see. `vault.projects`.
bind do-bitwarden-projects
  take body, like text
  take team, like text
  like list, like bank
  case node
    text <vault.projects($body, $team)>

# Exportable wrapper: a native `bind` is file-local.
task bitwarden-list
  mark async
  take body, like text
  take team, like text
  like list, like bank
  send back
    call do-bitwarden-projects
      bind body, read body
      bind team, read team
      wait true

# Exportable wrapper: a native `bind` is file-local.
task bitwarden-make
  take body, like text
  take name, like text
  like text
  send back
    call do-bitwarden-make
      bind body, read body
      bind name, read name

# Exportable wrapper: a native `bind` is file-local.
task bitwarden-open
  like boolean
  send back
    call do-bitwarden-open

# Exportable wrapper: a native `bind` is file-local.
task bitwarden-good
  take body, like text
  take bind, like text
  like boolean
  send back
    call do-bitwarden-good
      bind body, read body
      bind bind, read bind

# Exportable wrapper: a native `bind` is file-local.
task bitwarden-read
  take body, like text
  take bind, like text
  like list
  send back
    call do-bitwarden-read
      bind body, read body
      bind bind, read bind

# Write one secret, through the pinned `bws`.
#
# THE ONE CALL THAT PUTS A VALUE IN AN ARGUMENT. `bws` 2.1.0 takes a written
# value no other way, so for about a second `ps` can read it. Decision 004
# accepts that for `zone save` on the laptop alone, as an exception to
# decision 001. `vault.put` keeps it to one argument and redacts every error.
#
# Returns `made` or `grew`, so the caller can say which happened.
bind do-bitwarden-put
  mark async
  take body, like text
  take team, like text
  take bank, like text
  take mind, like text
  take name, like text
  take code, like text
  # the ids of the copies to update. Empty creates a new one
  take ids, like list, like text
  like text
  case node
    text <vault.put($body, $team, $bank, $mind, $name, $code, $ids)>

# Every stored copy of one name: id, note and project name. No value.
bind do-bitwarden-copies
  mark async
  take body, like text
  take team, like text
  take name, like text
  like list, like hold-copy
  case node
    text <vault.copies($body, $team, $name)>

# The note already stored against one name. Empty when there is none.
#
# Read so the caller can ADD to it rather than replace it, with the note
# readers in `code/tool/base.tree`. A note can name several zones, and
# rewriting it to the one being filed under drops the others.
bind do-bitwarden-note
  mark async
  take body, like text
  take team, like text
  take name, like text
  like text
  case node
    text <vault.note($body, $team, $name)>

# Every secret's name and note. METADATA ONLY: no value is fetched.
bind do-bitwarden-notes
  mark async
  take body, like text
  take team, like text
  like list, like hold-note
  case node
    text <vault.notes($body, $team)>

# Replace one secret's note, leaving its value exactly as it was.
bind do-bitwarden-mark
  mark async
  take body, like text
  take team, like text
  take name, like text
  take mind, like text
  like boolean
  case node
    text <vault.mark($body, $team, $name, $mind)>

# Remove the copies named by id. How many went.
bind do-bitwarden-drop
  mark async
  take body, like text
  take team, like text
  take ids, like list, like text
  like number
  case node
    text <vault.drop($body, $team, $ids)>

# Read one copy's value, by id. Empty if it is not there.
bind do-bitwarden-one
  mark async
  take body, like text
  take team, like text
  take id, like text
  like text
  case node
    text <vault.one($body, $team, $id)>

# Exportable wrappers: a native `bind` is file-local.
task bitwarden-put
  mark async
  take body, like text
  take team, like text
  take bank, like text
  take mind, like text
  take name, like text
  take code, like text
  take ids, like list, like text
  like text
  send back
    call do-bitwarden-put
      bind body, read body
      bind team, read team
      bind bank, read bank
      bind mind, read mind
      bind name, read name
      bind code, read code
      bind ids, read ids
      wait true

task bitwarden-copies
  mark async
  take body, like text
  take team, like text
  take name, like text
  like list, like hold-copy
  send back
    call do-bitwarden-copies
      bind body, read body
      bind team, read team
      bind name, read name
      wait true

task bitwarden-note
  mark async
  take body, like text
  take team, like text
  take name, like text
  like text
  send back
    call do-bitwarden-note
      bind body, read body
      bind team, read team
      bind name, read name
      wait true

task bitwarden-notes
  mark async
  take body, like text
  take team, like text
  like list, like hold-note
  send back
    call do-bitwarden-notes
      bind body, read body
      bind team, read team
      wait true

task bitwarden-mark
  mark async
  take body, like text
  take team, like text
  take name, like text
  take mind, like text
  like boolean
  send back
    call do-bitwarden-mark
      bind body, read body
      bind team, read team
      bind name, read name
      bind mind, read mind
      wait true

task bitwarden-drop
  mark async
  take body, like text
  take team, like text
  take ids, like list, like text
  like number
  send back
    call do-bitwarden-drop
      bind body, read body
      bind team, read team
      bind ids, read ids
      wait true

task bitwarden-one
  mark async
  take body, like text
  take team, like text
  take id, like text
  like text
  send back
    call do-bitwarden-one
      bind body, read body
      bind team, read team
      bind id, read id
      wait true
