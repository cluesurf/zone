
# The repository declaration, at `.zone.tree` in a project root.
#
# It names what the project needs, never what those things are. A
# declaration is safe to commit, safe to read in a pull request, and useful
# on its own as documentation of what the project touches.
#
#   zone <1>
#   name talk
#
#   sort development
#     hold bitwarden
#     bind cluesurf-talk-development
#     need openai-api-key
#     need database-url
#     want sentry-dsn
#
# `need` must be present or the command will not run. `want` may be absent.
# Names are kebab-case here and become SCREAMING_SNAKE_CASE in the child's
# environment, the same rule the Term config system uses.

load ../base
  find deck
  find claim
  find need

load @term/base/text
  find text
  find to-upper-case
  find replace-all

load @term/base/path
  find join

load @term/base/list
  find list
  find find

load @term/base/maybe
  find maybe

load @term/base/boolean
  find boolean

load @term/base/file
  find read
  find test

load ../tool/base
  find equal
  find mine-deck

# The declaration file for a directory.
bind spot-deck
  take dir, like text
  like text
  case node
    text <require("node:path").join($dir, ".zone.tree")>

# Read a project's declaration. A project without one is fine: the command
# then runs with whatever the sort provides, and `zone test` says so.
task read-deck
  mark async
  take dir, like text
  like maybe
    head deck
  save at
    call spot-deck
      read dir
  fork case
    call test
      read at
    case false
      send back
        make none
  save text
    call read
      read at
  send back
    make some
      bind value
        call mine-deck
          read text

# What this project declares for one sort.
task stake
  take deck, like deck
  take sort, like text
  like maybe
    head claim
  send back
    call find
      bind list, read deck/sort
      bind test
        task same
          take it, like claim
          like boolean
          send back
            call equal
              read it/name
              read sort
